# Required signing keys. Generate long random values; never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_JWT_SECRET=replace-with-a-different-long-random-secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/PESTGM

# Optional one-time bootstrap administrator. Existing accounts are not changed.
INITIAL_ADMIN_EMAIL=admin@your-domain.tld
INITIAL_ADMIN_PASSWORD=replace-before-starting
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_CONTRACT=

# Production settings
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
